// clientBusinessStore.js

import { defineStore } from "pinia";
import { clientBusinessesCache } from "./app/utils/seed";

export const useClientBusinessStore = defineStore("clientbusiness", {
  state: () => ({
    items: [],
    loading: false,
    loaded: false,
    error: null,
    version: 0,
    updatedAt: null,
  }),

  getters: {
    data: (state) => state.items,
    total: (state) => state.items.length,
    isEmpty: (state) => state.items.length === 0,
    isReady: (state) => state.loaded && !state.loading,
    hasError: (state) => !!state.error,

    byId: (state) => {
      return (id) => state.items.find((item) => item.id === id);
    },
  },

  actions: {
    async init(force = false) {
      if (this.loaded && !force) return;

      this.loading = true;
      this.error = null;

      try {
        const { getScopedData } = useDataScope();

        const result = getScopedData(clientBusinessesCache);

        this.hydrate(result);
      } catch (err) {
        this.error = err?.message || "Gagal memuat data client business";

        console.error("[ClientBusinessStore] Failed to initialize:", err);
      } finally {
        this.loading = false;
      }
    },

    hydrate(payload = {}) {
      this.items = Array.isArray(payload.data) ? payload.data : [];

      this.version = payload.version ?? 0;
      this.updatedAt = payload.time_updated ?? null;
      this.loaded = true;
    },

    async refresh() {
      await this.init(true);
    },

    reset() {
      this.items = [];
      this.loading = false;
      this.loaded = false;
      this.error = null;
      this.version = 0;
      this.updatedAt = null;
    },
  },
});

